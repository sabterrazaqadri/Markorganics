# Neon Postgres connection string (use the pooled host on Vercel)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# First Owner account, created on first sign-in if no staff account exists.
# After that these are ignored: staff are managed at /admin/settings/staff.
ADMIN_EMAIL="owner@markorganics.pk"
ADMIN_PASSWORD="change-me-at-least-10-chars"
ADMIN_NAME="Owner"

# 32+ random characters used to sign the admin session cookie (HMAC-SHA256).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Canonical site origin, no trailing slash. Used in metadata, sitemap, feeds and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://markorganics.pk"

# WhatsApp number in international format without "+" (contact links and admin wa.me links)
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"

# Google Analytics 4 measurement ID. Leave empty to disable the snippet entirely.
NEXT_PUBLIC_GA_ID=""
