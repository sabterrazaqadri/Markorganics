# Neon Postgres connection string (use the pooled host on Vercel)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# First Owner account, created on first sign-in if no staff account exists.
# After that these are ignored: staff are managed at /admin/settings/staff.
ADMIN_EMAIL="owner@markorganics.pk"
ADMIN_PASSWORD="change-me-at-least-10-chars"
ADMIN_NAME="Owner"

# 32+ random characters used to sign the admin session cookie (HMAC-SHA256).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Canonical site origin, no trailing slash. Used in metadata, sitemap, feeds and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://markorganics.pk"

# WhatsApp number in international format without "+" (contact links and admin wa.me links)
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"

# Google Analytics 4 measurement ID. Leave empty to disable the snippet entirely.
NEXT_PUBLIC_GA_ID=""

# ---------------------------------------------------------------- integrations

# 32 bytes of hex (or base64) used to encrypt integration credentials with
# AES-256-GCM before they are written to the database. Without it, credentials
# cannot be saved and every integration stays permanently in dry run.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=""

# Protects /api/jobs/run and /api/cron/*. Send as "x-jobs-secret: <value>".
# Generate the same way as above. With neither this nor CRON_SECRET set, both
# endpoints refuse every request.
JOBS_RUNNER_SECRET=""

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>". Set this to the same
# value you configure in the Vercel project so the scheduled runs are accepted.
CRON_SECRET=""

# Every credential below is optional and is normally set in the admin, at
# /admin/integrations, where it is stored encrypted. These environment
# variables are only a fallback for local development, and they are used
# verbatim without encryption — never put a production token here.
#
#   POSTEX_API_TOKEN, POSTEX_BASE_URL, POSTEX_DEFAULT_PICKUP_CODE
#   WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_WABA_ID,
#   WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN
#   META_ACCESS_TOKEN, META_PIXEL_ID
#   GOOGLE_API_SECRET, GOOGLE_MEASUREMENT_ID, GOOGLE_SEARCH_CONSOLE_TOKEN
#   TIKTOK_ACCESS_TOKEN, TIKTOK_PIXEL_CODE, TIKTOK_ADVERTISER_ID
